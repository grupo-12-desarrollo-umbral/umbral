{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet ef:*)",
      "Bash(dotnet tool:*)",
      "Bash(docker:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "make *",
      "dotnet *",
      "docker *"
    ]
  }
}
