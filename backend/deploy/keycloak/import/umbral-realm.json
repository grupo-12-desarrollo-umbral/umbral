{
  "realm": "umbral",
  "enabled": true,
  "displayName": "Umbral",
  "loginTheme": "umbral",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "resetCredentialsFlow": "reset credentials",
  "verifyEmail": true,
  "defaultRole": {
    "name": "default-roles-umbral",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false,
    "containerId": "umbral"
  },
  "actionTokenGeneratedByUserLifespan": 900,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 43200,
  "revokeRefreshToken": false,
  "smtpServer": {
    "host": "${KC_SMTP_HOST:mailpit}",
    "port": "${KC_SMTP_PORT:1025}",
    "from": "${KC_SMTP_FROM:no-reply@umbral.local}",
    "fromDisplayName": "${KC_SMTP_FROM_DISPLAY_NAME:Umbral}",
    "ssl": "${KC_SMTP_SSL:false}",
    "starttls": "${KC_SMTP_STARTTLS:false}",
    "auth": "${KC_SMTP_AUTH:false}",
    "user": "${KC_SMTP_USER:}",
    "password": "${KC_SMTP_PASSWORD:}"
  },
  "roles": {
    "realm": [
      {
        "name": "default-roles-umbral",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        },
        "clientRole": false
      },
      {
        "name": "Administrator",
        "description": "Administrative platform access"
      },
      {
        "name": "Operator",
        "description": "Operational platform access"
      },
      {
        "name": "Participant",
        "description": "Participant platform access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "umbral-web",
      "name": "umbral-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "umbral-web-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "umbral-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "umbral-mobile",
      "name": "umbral-mobile",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "umbral-mobile-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "umbral-mobile",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "umbral-web-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "umbral-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "umbral-backend",
      "name": "umbral-backend",
      "description": "Confidential service-account client backend services use to call the Keycloak Admin API on the umbral realm.",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "secret": "umbral-backend-dev-secret"
    }
  ],
  "users": [
    {
      "username": "service-account-umbral-backend",
      "enabled": true,
      "serviceAccountClientId": "umbral-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-realm"
        ]
      }
    },
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@umbral.local",
      "firstName": "Admin",
      "lastName": "Umbral",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Administrator"
      ]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "email": "operator@umbral.local",
      "firstName": "Operator",
      "lastName": "Umbral",
      "credentials": [
        {
          "type": "password",
          "value": "operator123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Operator"
      ]
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "participant",
      "enabled": true,
      "emailVerified": true,
      "email": "participant@umbral.local",
      "firstName": "Participant",
      "lastName": "Umbral",
      "credentials": [
        {
          "type": "password",
          "value": "participant123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Participant"
      ]
    },
    {
      "id": "44444444-4444-4444-4444-444444444444",
      "username": "operator2",
      "enabled": true,
      "emailVerified": true,
      "email": "operator2@umbral.local",
      "firstName": "Operator",
      "lastName": "Dos",
      "credentials": [
        {
          "type": "password",
          "value": "operator123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Operator"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
