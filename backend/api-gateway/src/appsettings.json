{
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/umbral",
    "Audience": "umbral-web"
  },
  "ReverseProxy": {
    "Routes": {
      "mission-design": {
        "ClusterId": "mission-design",
        "Match": {
          "Path": "/api/missions/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "identity-register": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/register"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "register"
      },
      "identity-forgot-password": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/forgot-password"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "register"
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "identity-teams": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/teams/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "identity-permissions": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/permissions/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "scoring-ranking": {
        "ClusterId": "scoring",
        "Match": {
          "Path": "/api/sessions/{liveSessionId}/ranking"
        },
        "AuthorizationPolicy": "default"
      },
      "scoring-ranking-operator": {
        "ClusterId": "scoring",
        "Match": {
          "Path": "/api/sessions/{liveSessionId}/ranking/operator"
        },
        "AuthorizationPolicy": "default"
      },
      "scoring-penalties": {
        "ClusterId": "scoring",
        "Match": {
          "Path": "/api/sessions/{liveSessionId}/penalties"
        },
        "AuthorizationPolicy": "default"
      },
      "scoring-hub": {
        "ClusterId": "scoring",
        "Match": {
          "Path": "/hubs/scoring/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "session-ops": {
        "ClusterId": "session-ops",
        "Match": {
          "Path": "/api/sessions/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "session-ops-hubs": {
        "ClusterId": "session-ops",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      },
      "scoring": {
        "ClusterId": "scoring",
        "Match": {
          "Path": "/api/scoring/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "mission-design": {
        "Destinations": {
          "d1": {
            "Address": "http://mission-design-service:8080/"
          }
        }
      },
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://identity-access-service:8080/"
          }
        }
      },
      "session-ops": {
        "Destinations": {
          "d1": {
            "Address": "http://session-operations-service:8080/"
          }
        }
      },
      "scoring": {
        "Destinations": {
          "d1": {
            "Address": "http://scoring-monitoring-service:8080/"
          }
        }
      }
    }
  }
}
