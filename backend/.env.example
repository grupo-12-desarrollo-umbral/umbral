# Copy to `.env` (which is gitignored) and fill in to override compose defaults.
# Docker Compose auto-loads backend/.env for `docker compose up`.

# ----------------------------------------------------------------------------
# Keycloak SMTP (outgoing mail: email verification, password reset, etc.)
#
# Leave everything below unset to keep the default behaviour: mail is caught
# locally by Mailpit and never leaves the machine (web UI at http://localhost:8025).
#
# To send REAL email via Mailjet (free 6,000/month, no credit card, personal
# email accepted at signup):
#   1. Sign up at https://www.mailjet.com (free plan).
#   2. Verify a sender address under "Senders & Domains".
#   3. Get SMTP credentials: Account Settings > REST API / SMTP -> API Key
#      (= KC_SMTP_USER) and Secret Key (= KC_SMTP_PASSWORD).
#   4. Uncomment and fill in the block below. KC_SMTP_FROM must be a verified sender.
# ----------------------------------------------------------------------------

# KC_SMTP_HOST=in-v3.mailjet.com
# KC_SMTP_PORT=587
# KC_SMTP_STARTTLS=true
# KC_SMTP_AUTH=true
# KC_SMTP_USER=your-mailjet-api-key
# KC_SMTP_PASSWORD=your-mailjet-secret-key
# KC_SMTP_FROM=verified-sender@example.com
# KC_SMTP_FROM_DISPLAY_NAME=Umbral

# ----------------------------------------------------------------------------
# Notes on other providers (same KC_SMTP_* fields, different host/creds):
#   - Mailsoftly  : free 2,000/mo, no card, personal email OK.
#   - SMTP2GO     : mail.smtp2go.com:587 -- but requires a WORK email at signup.
#   - Gmail       : smtp.gmail.com:587 -- needs a Google App Password.
# ----------------------------------------------------------------------------
