# Session encryption secret (generate with: openssl rand -base64 32)
SESSION_SECRET=dev-session-secret-change-in-production
KC_TOKEN_SECRET=

# Keycloak OIDC Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=umbral
KEYCLOAK_CLIENT_ID=umbral-web
KEYCLOAK_CLIENT_SECRET=

# Public Keycloak config (safe to expose to browser)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=umbral
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=umbral-web

# API Gateway (exposed on host port 8000 via backend/docker-compose.yml)
API_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
