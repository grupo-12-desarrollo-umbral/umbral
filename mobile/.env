# API Gateway — change host based on testing target:
#   iOS Simulator  → localhost
#   Android Emulator → 10.0.2.2
#   Physical device  → your LAN IP (e.g. 192.168.1.x)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Keycloak — same host rule as above
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8080
EXPO_PUBLIC_KEYCLOAK_REALM=umbral
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=umbral-mobile
